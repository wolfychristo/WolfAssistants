# ==========================================
# WolfAssistants - Comprehensive Git Ignore
# ==========================================

# --- Markdown Documents (ONLY root README.md is committed) ---
*.md
!/README.md

# --- Test Files, Diagnostics, Demos & Research ---
test/
tests/
test-*
*.test.*
*.spec.*
test-files.js
test-local-build.*
check_*.py
diagnose_*.py
setup_demo_*.py
trigger_*.py
delete_users_*.py
clear-ts-cache.*
Research/
.agents/

# --- Environment Variables & Secrets (CRITICAL: NEVER COMMIT) ---
.env
.env.*
!.env.example
!.env.*.template
*.pem
*.key
*.cert
*.crt
*.pfx
secrets.json
credentials.json

# --- Virtual Environments (Python) ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node / JavaScript Dependencies & Tools ---
node_modules/
jspm_packages/
.npm
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# --- Build Outputs & Bundles ---
build/
dist/
out/
.next/
*.tsbuildinfo
.parcel-cache/
.turbo/

# --- Databases & SQLite Stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
local_dev.db
local_test.db

# --- Logs & Performance Traces ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
audit.log
security_audit.log
application.log

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Coverage ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
coverage/

# --- IDE & Editor Settings (Local) ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Temporary Uploads & Attachments ---
temp_attachments/*
!temp_attachments/.gitkeep
temp/
tmp/
scratch/
