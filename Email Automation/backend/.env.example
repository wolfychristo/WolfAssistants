# ==============================================================================
# WolfAssistants Backend - Environment Configuration Template
# Copy this file to '.env' in this directory and fill in your production/development values.
# ==============================================================================

# --- Server & Core Environment ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=generate-a-secure-random-secret-key-at-least-32-chars

# --- CORS Settings (Comma-separated list of allowed web origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,https://wolfassistants.com

# --- Database Configuration (Supabase PostgreSQL Recommended) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# For Supabase connection pooler (Transaction mode, port 6543):
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase REST API (Optional fallback/management)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# --- Google Gemini AI Configuration (8-Key Load-Balanced Failover Pool) ---
# Provide at least 1 key. Keys 1-8 will automatically rotate upon rate limits (429) or quota errors.
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6
GEMINI_API_KEY_7=your-gemini-api-key-7
GEMINI_API_KEY_8=your-gemini-api-key-8

# --- System Email Configuration (Hostinger SMTP for OTPs, Verifications, System Alerts) ---
SYSTEM_EMAIL_HOST=smtp.hostinger.com
SYSTEM_EMAIL_PORT=587
SYSTEM_EMAIL_USER=info@yourcompany.com
SYSTEM_EMAIL_PASSWORD=your-secure-smtp-password
SYSTEM_EMAIL_FROM=WolfAssistants <info@yourcompany.com>
SYSTEM_EMAIL_USE_TLS=true

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-signing-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Rate Limiting & Performance Guardrails ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Circuit Breaker Settings ---
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# --- Monitoring & Logging ---
ENABLE_MONITORING=true
LOG_LEVEL=INFO
