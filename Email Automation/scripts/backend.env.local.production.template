# Local Production Environment Template for Backend
# Copy this file to backend/.env.local.production and fill in your values
# This is for testing production builds locally before deployment

# Core Configuration
ENVIRONMENT=production
SECRET_KEY=your-super-secure-secret-key-here-minimum-32-characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Database Configuration (Supabase)
DATABASE_URL=postgresql+psycopg://postgres.YOUR_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Or use separate databases:
# ACCOUNTS_DATABASE_URL=postgresql+psycopg://...
# TENANT_DATABASE_URL=postgresql+psycopg://...

# CORS Configuration (for local testing)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Configuration (Gemini API Keys)
# Add at least one, multiple for load balancing
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
# GEMINI_API_KEY_3=...
# GEMINI_API_KEY_4=...
# GEMINI_API_KEY_5=...
# GEMINI_API_KEY_6=...
# GEMINI_API_KEY_7=...
# GEMINI_API_KEY_8=...

# System Email Configuration (for OTPs and notifications)
SYSTEM_EMAIL_HOST=smtp.gmail.com
SYSTEM_EMAIL_PORT=587
SYSTEM_EMAIL_USER=info@yourcompany.com
SYSTEM_EMAIL_PASSWORD=your-app-password
SYSTEM_EMAIL_FROM=WolfAssistants <info@yourcompany.com>
SYSTEM_EMAIL_USE_TLS=true

# Security Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=INFO

# API Key Categorization (Optional)
API_KEY_CATEGORIZATION_ENABLED=true
API_KEY_ENTERPRISE_KEYS=1,2
API_KEY_PROFESSIONAL_KEYS=3,4
API_KEY_STARTER_KEYS=5,6
API_KEY_FREE_KEYS=7,8

# Engagement Thresholds (Optional)
ENGAGEMENT_ENTERPRISE_EMAILS=1000
ENGAGEMENT_PROFESSIONAL_EMAILS=100
ENGAGEMENT_STARTER_EMAILS=10

# Request Queue (Optional)
REQUEST_QUEUE_ENABLED=false
REQUEST_QUEUE_MAX_CONCURRENT=20

# Circuit Breaker (Optional)
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
